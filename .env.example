# Supabase (create a new, separate Supabase project for Settlr —
# do not reuse the GSTMatch project, per the "fully standalone" requirement)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cashfree Payment Gateway (Billing)
# Get these from Cashfree dashboard > Developers > API Keys.
# CASHFREE_ENV=sandbox while testing; set to "production" to go live.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Must match CASHFREE_ENV so the client-side checkout SDK opens the right
# environment.
NEXT_PUBLIC_CASHFREE_ENV=sandbox
# Canonical external app URL used for Cashfree redirect/return whitelisting.
# This must exactly match one of the whitelisted domains in Cashfree.
NEXT_PUBLIC_APP_URL=https://www.settlr.cyou

# Admin dashboard allowlist (comma-separated emails). Anyone NOT on this
# list gets a 404 when visiting /admin.
ADMIN_EMAILS=

